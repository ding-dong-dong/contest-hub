        "title": "HTTPValidationError"
      },
      "LinkStatus": {
        "properties": {
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "待确认"
          },
          "registration": {
            "type": "string",
            "title": "Registration",
            "default": "待确认"
          }
        },
        "type": "object",
        "title": "LinkStatus"
      },
      "RecommendItem": {
        "properties": {
          "competition_id": {
            "type": "string",
            "title": "Competition Id",
            "description": "竞赛 ID，对应 contest.id"
          },
          "total_score": {
            "type": "number",
            "title": "Total Score",
            "description": "推荐总分（0-100），等于 scores 五项之和"
          },
          "match_level": {
            "type": "string",
            "title": "Match Level",
            "description": "匹配档位标签（产品文档第五章第4节）：高度匹配(80-100)/较为匹配(60-79)/可进一步了解(0-59)",
            "default": ""
          },
          "scores": {
            "$ref": "#/components/schemas/ScoreBreakdown"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons",
            "description": "个性化推荐理由，第1条为总结（含免责声明），至少2条"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "风险提示文案，如截止日期待确认、链接待复核"
          },
          "qualification_pending": {
            "type": "boolean",
            "title": "Qualification Pending",
            "description": "资格范围待人工确认（适用年级/院校不明），true 时前端必须显示风险提示",
            "default": false
          },
          "verification_pending": {
            "type": "boolean",
            "title": "Verification Pending",
            "description": "链接/状态待复核，true 时对应官方入口需标注待确认",
            "default": false
          },
          "contest": {
            "$ref": "#/components/schemas/ContestOut"
          }
        },
        "type": "object",
        "required": [
          "competition_id",
          "total_score",
          "scores",
          "contest"
        ],
        "title": "RecommendItem",
        "description": "前端 V1 契约：扁平字段 + 分数明细 + 理由/告警/待确认标记。"
      },
      "RecommendResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/RecommendItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "items"
        ],
        "title": "RecommendResponse"
      },
      "ScoreBreakdown": {
        "properties": {
          "major_interest": {
            "type": "number",
            "title": "Major Interest",
            "default": 0.0
          },
          "grade_experience": {
            "type": "number",
            "title": "Grade Experience",
            "default": 0.0
          },
          "time": {
            "type": "number",
            "title": "Time",
            "default": 0.0
          },
          "value": {
            "type": "number",
            "title": "Value",
            "default": 0.0
          },
          "trust": {
            "type": "number",
            "title": "Trust",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "ScoreBreakdown",
        "description": "推荐评分明细（满分 100），与前端契约键名一致。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}