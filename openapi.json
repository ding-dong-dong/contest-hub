{
  "openapi": "3.1.0",
  "info": {
    "title": "竞赛信息管理后端",
    "description": "竞赛信息 CRUD + 智能推荐服务。字段定义参考田淋元产品文档第四章与连诗钰前端 V1 契约。\n\n推荐接口使用硬过滤 + 软评分（100 分制）排序返回。\n\n字段命名：接口统一 snake_case，前端 adapter 负责映射驼峰。\n\n写接口（POST/PUT/DELETE）受保护：服务端设置 ADMIN_KEY 后需携带 X-Admin-Key 请求头；READ_ONLY=1 时完全关闭。",
    "version": "1.2.0"
  },
  "paths": {
    "/contests/recommend": {
      "get": {
        "summary": "智能推荐",
        "description": "接收用户画像，按硬过滤（已截止/取消、年级、专业、院校）排除后，用软评分（专业兴趣30 + 年级经验25 + 时间可行性20 + 可验证价值15 + 信息可信度10）降序返回，每条附匹配理由。interests 可重复传参。",
        "operationId": "get_recommend_contests_recommend_get",
        "parameters": [
          {
            "name": "grade",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "大一/大二/大三/大四/研究生/其他",
              "title": "Grade"
            },
            "description": "大一/大二/大三/大四/研究生/其他"
          },
          {
            "name": "major",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "计算机/电子信息/经管/设计/机械/材料/理学/文法/医学/其他",
              "title": "Major"
            },
            "description": "计算机/电子信息/经管/设计/机械/材料/理学/文法/医学/其他"
          },
          {
            "name": "interests",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "兴趣标签，可重复传参",
              "title": "Interests"
            },
            "description": "兴趣标签，可重复传参"
          },
          {
            "name": "experience",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "无经验/参加过但未获奖/有获奖经验",
              "title": "Experience"
            },
            "description": "无经验/参加过但未获奖/有获奖经验"
          },
          {
            "name": "time_per_week",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "≤3小时/4-7小时/8-14小时/≥15小时",
              "title": "Time Per Week"
            },
            "description": "≤3小时/4-7小时/8-14小时/≥15小时"
          },
          {
            "name": "school",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "院校名称（可选）",
              "default": "",
              "title": "School"
            },
            "description": "院校名称（可选）"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
